<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_qss_quotation_form" model="ir.ui.view">
    <field name="name">qss.quotation.form</field>
    <field name="model">qss.quotation</field>
    <field name="arch" type="xml">
      <form string="Quotation">

        <!-- HEADER must come first -->
        <header>
          <button name="%(qss_portal.action_report_qss_quotation)d"
                  type="action"
                  string="Download Quotation"
                  class="btn-primary"/>
          <button name="action_create_invoice"
                  type="object"
                  string="Create Invoice"
                  class="btn-primary"
                  groups="qss_portal.group_qss_accounts"
                  />
        </header>

        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="enquiry_id"/>
            <field name="client_id" readonly="1"/>
            <field name="amount_total"/>
            <field name="state" widget="statusbar"/>
          </group>
          <group string="Client Work Order">
            <field name="approved_work_order"
                   filename="approved_work_order_filename"/>
            <field name="approved_work_order_filename" invisible="1"/>
          </group>
        </sheet>

        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_qss_quotation_tree" model="ir.ui.view">
    <field name="name">qss.quotation.tree</field>
    <field name="model">qss.quotation</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="enquiry_id"/>
        <field name="client_id"/>
        <field name="amount_total"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="action_qss_quotation" model="ir.actions.act_window">
    <field name="name">Quotations</field>
    <field name="res_model">qss.quotation</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
